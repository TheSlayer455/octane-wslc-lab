{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octane.invalid/schemas/browser-candidate-lock-v1.json",
  "title": "Octane browser candidate lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "status", "createdAtUtc", "identities", "harness", "fixtures", "runtime", "browser", "host", "security", "qualification"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "browser-candidate-lock" },
    "status": { "enum": ["candidate-end-to-end-blocked", "candidate-ready-for-qualification", "qualified"] },
    "createdAtUtc": { "type": "string", "format": "date-time" },
    "identities": { "type": "object" },
    "harness": {
      "type": "object",
      "required": ["files"],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "fixtures": {
      "type": "object",
      "required": ["files"],
      "properties": {
        "files": { "type": "array", "minItems": 1 }
      }
    },
    "runtime": { "type": "object" },
    "browser": { "type": "object" },
    "host": { "type": "object" },
    "security": { "type": "object" },
    "qualification": { "type": "object" }
  }
}
