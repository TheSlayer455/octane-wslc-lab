{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octane.invalid/schemas/application-profile-v1.json",
  "title": "Octane application profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "status", "runtime", "installer", "application", "fileAccess", "network", "scenario"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,47}$" },
    "status": { "enum": ["template", "preview-only", "scenario-defined", "qualified"] },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["octaneRelease", "wineProfile"],
      "properties": {
        "octaneRelease": { "type": "string", "minLength": 1, "maxLength": 96 },
        "wineProfile": { "const": "DockerWineStaging1121VisRgnBrowser" }
      }
    },
    "installer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "architecture", "installArguments", "argumentsVerified", "timeoutSeconds", "successCodes", "scope"],
      "properties": {
        "kind": { "enum": ["nsis"] },
        "architecture": { "const": "x64" },
        "installArguments": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 2048 } },
        "argumentsVerified": { "type": "boolean" },
        "timeoutSeconds": { "type": "integer", "minimum": 30, "maximum": 3600 },
        "successCodes": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 65535 } },
        "scope": { "enum": ["current-user"] }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executableFileName", "expectedRelativePath", "launchArguments", "windowTitleRegex", "readinessTimeoutSeconds", "readinessStabilitySeconds", "webView2"],
      "properties": {
        "executableFileName": { "type": "string", "pattern": "^[A-Za-z0-9._ -]{1,128}\\.exe$" },
        "expectedRelativePath": { "type": ["string", "null"], "maxLength": 512 },
        "launchArguments": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 2048 } },
        "windowTitleRegex": { "type": "string", "minLength": 1, "maxLength": 512 },
        "readinessTimeoutSeconds": { "type": "integer", "minimum": 10, "maximum": 900 },
        "readinessStabilitySeconds": { "type": "integer", "minimum": 10, "maximum": 300 },
        "visualReadinessMinColors": { "type": "integer", "minimum": 0, "maximum": 65536 },
        "webView2": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "distribution", "expectedVersion"],
          "properties": {
            "required": { "type": "boolean" },
            "distribution": { "enum": ["evergreen", "installer-managed", "not-declared"] },
            "expectedVersion": { "type": ["string", "null"], "pattern": "^[0-9]+(\\.[0-9]+){3}$" }
          }
        }
      }
    },
    "fileAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "wineInputPath", "wineOutputPath", "inputReadOnly"],
      "properties": {
        "mode": { "const": "copy" },
        "wineInputPath": { "const": "C:\\octane-input" },
        "wineOutputPath": { "const": "C:\\octane-output" },
        "inputReadOnly": { "const": true }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredEndpoints"],
      "properties": {
        "requiredEndpoints": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "url", "expectedStatusCodes"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,47}$" },
              "url": { "type": "string", "format": "uri", "maxLength": 2048 },
              "expectedStatusCodes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": { "type": "integer", "minimum": 100, "maximum": 599 }
              }
            }
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "trustedScenarioId"],
      "properties": {
        "status": { "enum": ["manual-only", "trusted"] },
        "trustedScenarioId": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]{1,63}$" }
      }
    }
  }
}
