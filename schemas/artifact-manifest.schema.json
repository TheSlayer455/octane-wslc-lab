{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octane.invalid/schemas/artifact-manifest-v1.json",
  "title": "Octane immutable installer manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactId", "originalFileName", "stagedFileName", "length", "sha256", "calculatedAtUtc", "acquiredAtUtc", "buildLabel", "producerSha256", "provenance", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}:[0-9]+$" },
    "originalFileName": { "type": "string", "minLength": 1, "maxLength": 255 },
    "stagedFileName": { "type": "string", "pattern": "^installer-[a-f0-9]{64}\\.exe$" },
    "length": { "type": "integer", "minimum": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "calculatedAtUtc": { "type": "string", "format": "date-time" },
    "acquiredAtUtc": { "type": "string", "format": "date-time" },
    "buildLabel": { "type": ["string", "null"], "maxLength": 256 },
    "producerSha256": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" },
    "provenance": { "type": ["string", "null"], "maxLength": 2048 },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inspected", "status", "subject", "thumbprint"],
      "properties": {
        "inspected": { "type": "boolean" },
        "status": { "type": ["string", "null"] },
        "subject": { "type": ["string", "null"] },
        "thumbprint": { "type": ["string", "null"] }
      }
    }
  }
}
