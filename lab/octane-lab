#!/usr/bin/env bash
set -euo pipefail
state_dir="${OCTANE_STATE_DIR:-/config}"
export WINEPREFIX="${WINEPREFIX:-$state_dir/octane-prefix}"
export WINEARCH="${WINEARCH:-win64}"
# Select a live X socket rather than trusting inherited image metadata. WineGUI
# currently exposes :0 to exec sessions; Docker-Wine RDP sessions may use a
# different display and retain their already-correct DISPLAY value.
if [[ -n "${DISPLAY:-}" && -S "/tmp/.X11-unix/X${DISPLAY#:}" ]]; then
    :
elif [[ -S /tmp/.X11-unix/X0 ]]; then
    export DISPLAY=:0
else
    for socket in /tmp/.X11-unix/X*; do
        [[ -S "$socket" ]] || continue
        export DISPLAY=":${socket##*X}"
        break
    done
fi
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-$state_dir/.XDG}"
evidence="${OCTANE_EVIDENCE_DIR:-$state_dir/octane-evidence}"
mkdir -p "$evidence"
export WINEDEBUG="${WINEDEBUG:--all,+timestamp,+seh}"
run_logged() {
    local stage="$1"; shift
    local stamp rc
    stamp=$(date -u +%Y%m%dT%H%M%SZ)
    set +e
    "$@" 2>&1 | tee "$evidence/$stage-$stamp.log"
    rc=${PIPESTATUS[0]}
    set -e
    printf '%s\n' "$rc" > "$evidence/$stage-$stamp.exitcode"
    return "$rc"
}
run_logged_direct() {
    local stage="$1"; shift
    local stamp rc log
    stamp=$(date -u +%Y%m%dT%H%M%SZ)
    log="$evidence/$stage-$stamp.log"
    set +e
    # Do not use a pipe here: long-lived EdgeUpdate children inherit the
    # installer's descriptors and can otherwise keep `tee` alive after NSIS.
    "$@" > "$log" 2>&1
    rc=$?
    set -e
    printf '%s\n' "$rc" > "$evidence/$stage-$stamp.exitcode"
    return "$rc"
}
record_environment() {
    wine --version > "$evidence/wine-version.txt"
    command -v wine > "$evidence/wine-command.txt"
    readlink -f "$(command -v wine)" >> "$evidence/wine-command.txt" || true
    uname -a > "$evidence/kernel.txt"
    cp /etc/os-release "$evidence/container-os-release.txt"
    {
        echo "display=${DISPLAY:-unset}"
        echo "xdg_runtime_dir=${XDG_RUNTIME_DIR:-unset}"
        echo "wineprefix=$WINEPREFIX"
        echo "winearch=$WINEARCH"
        echo "wine_dll_overrides=${WINEDLLOVERRIDES:-unset}"
        echo "x_sockets:"
        find /tmp/.X11-unix -maxdepth 1 -type s -printf '%f\n' 2>/dev/null | sort || true
    } > "$evidence/display-environment.txt"
    timeout 20 xdpyinfo > "$evidence/xdpyinfo.txt" 2>&1 || true
    timeout 20 xwininfo -root > "$evidence/xwininfo-root.txt" 2>&1 || true
    if command -v glxinfo >/dev/null 2>&1; then timeout 30 glxinfo -B > "$evidence/glxinfo.txt" 2>&1 || true; fi
    if command -v vulkaninfo >/dev/null 2>&1; then timeout 30 vulkaninfo --summary > "$evidence/vulkaninfo.txt" 2>&1 || true; fi
    cp /opt/octane/installer-manifest.json "$evidence/"
    [[ ! -f /opt/octane/diagnostic-manifest.json ]] || cp /opt/octane/diagnostic-manifest.json "$evidence/"
    sha256sum /opt/octane/Octane-setup.exe > "$evidence/installer-actual.sha256"
    [[ ! -f /opt/octane/WebView2Diagnostic.exe ]] || sha256sum /opt/octane/WebView2Diagnostic.exe > "$evidence/diagnostic-actual.sha256"
    {
        df -h / "$state_dir" /dev/shm 2>/dev/null || true
        echo
        echo 'cgroup:'
        cat /proc/self/cgroup 2>/dev/null || true
        for value in memory.current memory.max memory.events cpu.max pids.current pids.max; do
            [[ ! -f "/sys/fs/cgroup/$value" ]] || { printf '%s=' "$value"; cat "/sys/fs/cgroup/$value"; }
        done
    } > "$evidence/resources.txt"
    if [[ -f /opt/wine-stable/lib/wine/x86_64-windows/ole32.dll ]]; then
        sha256sum /opt/wine-stable/lib/wine/x86_64-windows/ole32.dll > "$evidence/ole32-active.sha256"
    fi
    if [[ -d /opt/octane/wine-overlay ]]; then
        cp /opt/octane/wine-overlay/wine-build.json "$evidence/"
        cp /opt/octane/wine-overlay/ole32.sha256 "$evidence/ole32-source-build.sha256"
        cp /opt/octane/wine-overlay/ole32.packaged.sha256 "$evidence/"
    fi
    if [[ -f /opt/octane-wine/share/octane/wine-build.json ]]; then
        cp /opt/octane-wine/share/octane/wine-build.json "$evidence/wine-source-build.json"
        cp /opt/octane-wine/share/octane/wine-staging-patches.sha256 "$evidence/"
        cp /opt/octane-wine/share/octane/wine-staging-patch-list.sha256 "$evidence/"
        sha256sum /opt/octane-wine/lib/wine/x86_64-unix/win32u.so > "$evidence/win32u-active.sha256"
        sha256sum /opt/octane-wine/lib/wine/x86_64-windows/ole32.dll > "$evidence/ole32-active.sha256"
    fi
}
find_octane() {
    mapfile -d '' apps < <(find "$WINEPREFIX/drive_c/users" -type f -iname 'octane.exe' -print0)
    if [[ ${#apps[@]} -ne 1 ]]; then
        echo 'Expected one installed octane.exe. Complete the current-user installer first.' >&2
        exit 1
    fi
    printf '%s' "${apps[0]}"
}

ensure_display() {
    local authority="${XAUTHORITY:-$HOME/.Xauthority}"
    local socket candidate

    if [[ -n "${DISPLAY:-}" ]] && DISPLAY="$DISPLAY" XAUTHORITY="$authority" xdpyinfo >/dev/null 2>&1; then
        export XAUTHORITY="$authority"
        return
    fi

    for socket in /tmp/.X11-unix/X*; do
        [[ -S "$socket" ]] || continue
        candidate=":${socket##*/X}"
        if DISPLAY="$candidate" XAUTHORITY="$authority" xdpyinfo >/dev/null 2>&1; then
            export DISPLAY="$candidate"
            export XAUTHORITY="$authority"
            return
        fi
    done

    echo 'No usable X11 display was found. Connect the desktop viewer before running a GUI command.' >&2
    return 1
}
case "${1:-help}" in
    environment)
        record_environment
        echo "Environment recorded beneath $evidence" ;;
    notepad)
        ensure_display
        record_environment
        run_logged notepad wine notepad ;;
    install)
        ensure_display
        run_logged install wine /opt/octane/Octane-setup.exe ;;
    install-silent)
        ensure_display
        run_logged_direct install-silent wine /opt/octane/Octane-setup.exe /S ;;
    launch)
        ensure_display
        app=$(find_octane)
        run_logged launch wine "$app" ;;
    launch-ole)
        ensure_display
        app=$(find_octane)
        export WINEDEBUG="${OCTANE_OLE_WINEDEBUG:-+timestamp,+ole,+seh}"
        run_logged launch-ole wine "$app" ;;
    diagnostic)
        ensure_display
        if [[ ! -f /opt/octane/WebView2Diagnostic.exe ]]; then
            echo 'WebView2Diagnostic.exe is not present in this image.' >&2
            exit 1
        fi
        record_environment
        mkdir -p "$state_dir/webview2-diagnostic-user-data"
        export OCTANE_DIAGNOSTIC_LOG
        export OCTANE_WEBVIEW2_USER_DATA
        OCTANE_DIAGNOSTIC_LOG=$(winepath -w "$evidence/webview2-diagnostic-events.log")
        OCTANE_WEBVIEW2_USER_DATA=$(winepath -w "$state_dir/webview2-diagnostic-user-data")
        export WINEDEBUG="${OCTANE_OLE_WINEDEBUG:-+timestamp,+ole,+seh}"
        run_logged webview2-diagnostic wine /opt/octane/WebView2Diagnostic.exe ;;
    experiment)
        ensure_display
        if [[ ! -x /usr/local/bin/octane-webview2-experiment ]]; then
            echo 'The WebView2 experiment runner is not present in this image.' >&2
            exit 1
        fi
        record_environment
        exec /usr/local/bin/octane-webview2-experiment ;;
    help|*)
        echo 'Usage: octane-lab {environment|notepad|install|install-silent|diagnostic|experiment|launch|launch-ole}'
        echo "Run as the desktop user. Export JSON beneath Z:${evidence//\//\\}." ;;
esac
