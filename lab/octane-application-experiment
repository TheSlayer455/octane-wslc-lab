#!/usr/bin/env bash
set -euo pipefail

state_dir="${OCTANE_STATE_DIR:-/config}"
evidence_root="${OCTANE_EVIDENCE_DIR:-$state_dir/octane-evidence}"
run_id="${OCTANE_APPLICATION_EXPERIMENT_ID:-$(date -u +%Y%m%dT%H%M%SZ)-$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')}"
if [[ ! "$run_id" =~ ^[A-Za-z0-9._-]{8,96}$ ]]; then
    echo 'OCTANE_APPLICATION_EXPERIMENT_ID must contain only letters, digits, dot, underscore, or dash.' >&2
    exit 2
fi

run_dir="$evidence_root/applications/$run_id"
if [[ -e "$run_dir" ]]; then
    echo "Application experiment directory already exists: $run_dir" >&2
    exit 2
fi
mkdir -p "$run_dir/logs" "$run_dir/screenshots"
interaction_log="$run_dir/logs/interaction.log"
: > "$interaction_log"

log_step() {
    printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >> "$interaction_log"
}

window_is_viewable() {
    xwininfo -id "$1" 2>/dev/null | grep -q 'Map State: IsViewable'
}

wait_window_not_viewable() {
    local id="$1"
    local timeout_seconds="$2"
    local deadline=$((SECONDS + timeout_seconds))
    while (( SECONDS < deadline )); do
        window_is_viewable "$id" || return 0
        sleep 0.25
    done
    return 1
}

mapfile -d '' apps < <(find "$WINEPREFIX/drive_c/users" -type f -iname 'octane.exe' -print0)
if [[ ${#apps[@]} -ne 1 ]]; then
    echo 'Expected exactly one installed octane.exe.' >&2
    exit 1
fi
app="${apps[0]}"
app_sha=$(sha256sum "$app" | cut -d' ' -f1)
started_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
app_pid=''
window_id=''

finish_processes() {
    if [[ -n "$app_pid" ]] && kill -0 "$app_pid" 2>/dev/null; then
        kill -TERM "$app_pid" 2>/dev/null || true
    fi
    WINEPREFIX="$WINEPREFIX" wineserver -k >/dev/null 2>&1 || true
}
trap finish_processes EXIT INT TERM

{
    echo "started_at_utc=$started_at"
    echo "run_id=$run_id"
    echo "display=${DISPLAY:-unset}"
    echo "wineprefix=$WINEPREFIX"
    echo "winearch=${WINEARCH:-unset}"
    echo "installed_executable=$app"
    echo "installed_executable_sha256=$app_sha"
    echo "wine_dll_overrides=${WINEDLLOVERRIDES:-unset}"
} > "$run_dir/requested-settings.txt"

WINEDEBUG="${OCTANE_APPLICATION_WINEDEBUG:--all,+timestamp,+seh}" wine "$app" > "$run_dir/logs/wine.log" 2>&1 &
app_pid=$!
echo "$app_pid" > "$run_dir/launcher-linux-pid.txt"

deadline=$((SECONDS + 75))
while (( SECONDS < deadline )); do
    window_id=$(xdotool search --onlyvisible --name 'Octane.*File analysis lab' 2>/dev/null | tail -n 1 || true)
    [[ -n "$window_id" ]] && break
    kill -0 "$app_pid" 2>/dev/null || break
    sleep 0.5
done

native_window=FAIL
screen_changed=FAIL
workload=FAIL
native_dialogs=FAIL
export_status=FAIL
overwrite_decline=FAIL
report_path=''
report_sha_before=''
report_sha_after=''
pixel_difference=0
repaint_nudge='not-needed'
repaint_nudge_ms=0
repaint_nudge_attempts=0
client_color_count=0

measure_client_colors() {
    local image="$1" width height crop_y=40
    [[ -s "$image" ]] || { printf '0'; return; }
    read -r width height < <(identify -format '%w %h\n' "$image")
    if (( height <= crop_y )); then printf '0'; return; fi
    convert "$image" -crop "${width}x$((height-crop_y))+0+$crop_y" +repage -format '%k' info:
}

if [[ -n "$window_id" ]]; then
    native_window=PASS
    echo "$window_id" > "$run_dir/native-window-id.txt"
    xwininfo -id "$window_id" > "$run_dir/logs/xwininfo.txt" 2>&1 || true
    import -window "$window_id" "$run_dir/screenshots/octane-initial.png" 2> "$run_dir/logs/import-initial.log" || true

    # The measured Wine-Staging control required a bounded focus/input repaint
    # nudge before WebView2 presented its already-created client surface.
    xdotool windowactivate --sync "$window_id" >> "$run_dir/logs/interaction.log" 2>&1 || true
    xdotool mousemove --window "$window_id" 520 420 click 1 >> "$run_dir/logs/interaction.log" 2>&1 || true
    xdotool key --window "$window_id" Tab Return >> "$run_dir/logs/interaction.log" 2>&1 || true
    sleep 6
    import -window "$window_id" "$run_dir/screenshots/octane-after-focus.png" 2> "$run_dir/logs/import-after-focus.log" || true
    client_color_count=$(measure_client_colors "$run_dir/screenshots/octane-after-focus.png")

    if [[ -s "$run_dir/screenshots/octane-initial.png" && -s "$run_dir/screenshots/octane-after-focus.png" ]]; then
        set +e
        pixel_difference=$(compare -metric AE "$run_dir/screenshots/octane-initial.png" "$run_dir/screenshots/octane-after-focus.png" null: 2>&1)
        set -e
        if [[ "$pixel_difference" =~ ^[0-9]+$ ]] && (( pixel_difference > 1000 )) && [[ "$client_color_count" =~ ^[0-9]+$ ]] && (( client_color_count > 100 )); then
            screen_changed=PASS
        fi
    fi

    if [[ "$screen_changed" != PASS ]]; then
        repaint_nudge='resize-minimize-restore'
        nudge_started_ms=$(date -u +%s%3N)
        for attempt in 1 2 3; do
            repaint_nudge_attempts=$attempt
            xdotool windowsize --sync "$window_id" 900 650 >> "$run_dir/logs/interaction.log" 2>&1 || true
            sleep 1
            xdotool windowminimize "$window_id" >> "$run_dir/logs/interaction.log" 2>&1 || true
            sleep 1
            xdotool windowmap "$window_id" >> "$run_dir/logs/interaction.log" 2>&1 || true
            xdotool windowactivate --sync "$window_id" >> "$run_dir/logs/interaction.log" 2>&1 || true
            sleep 3
            nudge_image="$run_dir/screenshots/octane-after-repaint-nudge-$attempt.png"
            import -window "$window_id" "$nudge_image" 2> "$run_dir/logs/import-after-repaint-nudge-$attempt.log" || true
            client_color_count=$(measure_client_colors "$nudge_image")
            if [[ "$client_color_count" =~ ^[0-9]+$ ]] && (( client_color_count > 100 )); then
                cp "$nudge_image" "$run_dir/screenshots/octane-after-repaint-nudge.png"
                break
            fi
        done
        repaint_nudge_ms=$(( $(date -u +%s%3N) - nudge_started_ms ))
        if [[ -s "$run_dir/screenshots/octane-initial.png" && -s "$run_dir/screenshots/octane-after-repaint-nudge.png" ]]; then
            set +e
            pixel_difference=$(compare -metric AE "$run_dir/screenshots/octane-initial.png" "$run_dir/screenshots/octane-after-repaint-nudge.png" null: 2>&1)
            set -e
            if [[ "$pixel_difference" =~ ^[0-9]+$ ]] && (( pixel_difference > 1000 )) && [[ "$client_color_count" =~ ^[0-9]+$ ]] && (( client_color_count > 100 )); then
                screen_changed=PASS
            fi
        fi
    fi

    # Invoke the real installed application's sample fixture command.
    xdotool mousemove --window "$window_id" 225 190 click 1 >> "$run_dir/logs/interaction.log" 2>&1 || true
    sleep 5
    import -window "$window_id" "$run_dir/screenshots/octane-workload.png" 2> "$run_dir/logs/import-workload.log" || true

    # Export through the native save dialog. The fixed default filename makes
    # the second save a deterministic existing-file/no-overwrite check. Focus
    # Load sample, then move one tab: Wine's save dialog is not reliable when
    # synthesized as a direct pointer click, while keyboard activation matches
    # the measured black-box interaction path.
    xdotool mousemove --window "$window_id" 225 190 click 1 >> "$run_dir/logs/interaction.log" 2>&1 || true
    xdotool key --window "$window_id" Tab Return >> "$run_dir/logs/interaction.log" 2>&1 || true
    deadline=$((SECONDS + 15))
    save_dialog=''
    while (( SECONDS < deadline )); do
        save_dialog=$(xdotool search --onlyvisible --name '^Save$' 2>/dev/null | tail -n 1 || true)
        [[ -n "$save_dialog" ]] && break
        sleep 0.25
    done
    if [[ -n "$save_dialog" ]]; then
        log_step "first save dialog id=$save_dialog"
        import -window root "$run_dir/screenshots/native-save-dialog.png" 2> "$run_dir/logs/import-save-dialog.log" || true
        xdotool windowactivate --sync "$save_dialog" >> "$run_dir/logs/interaction.log" 2>&1 || true
        xdotool key --window "$save_dialog" ctrl+a >> "$run_dir/logs/interaction.log" 2>&1 || true
        xdotool type --window "$save_dialog" --delay 20 'octane-report.json' >> "$run_dir/logs/interaction.log" 2>&1 || true
        xdotool key --window "$save_dialog" Return >> "$run_dir/logs/interaction.log" 2>&1 || true
        deadline=$((SECONDS + 20))
        while (( SECONDS < deadline )); do
            report_path=$(find "$HOME" -maxdepth 4 -type f -iname 'octane-report.json' -print -quit 2>/dev/null || true)
            if [[ -z "$report_path" ]]; then
                report_path=$(find -L "$WINEPREFIX/drive_c/users" -type f -iname 'octane-report.json' -print -quit 2>/dev/null || true)
            fi
            [[ -n "$report_path" ]] && break
            sleep 0.25
        done
        if [[ -n "$report_path" ]]; then
            log_step "first export created report=$report_path"
        else
            log_step 'first export did not create a report before the deadline'
        fi
        # The file can become visible before Wine destroys the native dialog.
        # Wait for that exact dialog to disappear so the next activation cannot
        # accidentally target the stale first-save window.
        if wait_window_not_viewable "$save_dialog" 5; then
            log_step "first save dialog closed id=$save_dialog"
        else
            log_step "first save dialog remained viewable id=$save_dialog"
        fi
    fi

    if [[ -n "$report_path" && -s "$report_path" ]] && jq -e '
        .schemaVersion == 1 and
        (.files | length) == 8 and
        (.groups | length) == 6 and
        (.duplicateSets | length) == 1 and
        (.errors | length) == 0 and
        .totalBytes == 176
    ' "$report_path" >/dev/null; then
        workload=PASS
        export_status=PASS
        cp "$report_path" "$run_dir/report.json"
        report_sha_before=$(sha256sum "$report_path" | cut -d' ' -f1)

        xdotool windowactivate --sync "$window_id" >> "$run_dir/logs/interaction.log" 2>&1 || true
        xdotool mousemove --window "$window_id" 225 190 click 1 >> "$run_dir/logs/interaction.log" 2>&1 || true
        xdotool key --window "$window_id" Tab Return >> "$run_dir/logs/interaction.log" 2>&1 || true
        deadline=$((SECONDS + 15))
        save_dialog=''
        while (( SECONDS < deadline )); do
            save_dialog=$(xdotool search --onlyvisible --name '^Save$' 2>/dev/null | head -n 1 || true)
            [[ -n "$save_dialog" ]] && break
            sleep 0.25
        done
        if [[ -n "$save_dialog" ]]; then
            log_step "second save dialog id=$save_dialog"
            xdotool windowactivate --sync "$save_dialog" >> "$run_dir/logs/interaction.log" 2>&1 || true
            xdotool key --window "$save_dialog" Return >> "$run_dir/logs/interaction.log" 2>&1 || true
            deadline=$((SECONDS + 10))
            confirm_dialog=''
            while (( SECONDS < deadline )); do
                while IFS= read -r candidate; do
                    if [[ -n "$candidate" && "$candidate" != "$save_dialog" ]]; then
                        confirm_dialog="$candidate"
                    fi
                done < <(xdotool search --onlyvisible --name '^Save$' 2>/dev/null || true)
                [[ -n "$confirm_dialog" ]] && break
                sleep 0.25
            done
            if [[ -n "$confirm_dialog" ]]; then
                log_step "overwrite confirmation id=$confirm_dialog"
                import -window root "$run_dir/screenshots/native-overwrite-confirmation.png" 2> "$run_dir/logs/import-overwrite.log" || true
                xdotool windowactivate --sync "$confirm_dialog" >> "$run_dir/logs/interaction.log" 2>&1 || true
                xdotool key --window "$confirm_dialog" Tab Return >> "$run_dir/logs/interaction.log" 2>&1 || true
                wait_window_not_viewable "$confirm_dialog" 5 || log_step "overwrite confirmation remained viewable id=$confirm_dialog"
                if window_is_viewable "$save_dialog"; then
                    xdotool key --window "$save_dialog" Escape >> "$run_dir/logs/interaction.log" 2>&1 || true
                    wait_window_not_viewable "$save_dialog" 5 || log_step "second save dialog remained viewable id=$save_dialog"
                fi
                sleep 1
                report_sha_after=$(sha256sum "$report_path" | cut -d' ' -f1)
                if [[ "$report_sha_before" = "$report_sha_after" ]]; then
                    overwrite_decline=PASS
                    log_step 'overwrite decline preserved the existing report hash'
                fi
            else
                log_step 'overwrite confirmation did not appear before the deadline'
            fi
        else
            log_step 'second save dialog did not appear before the deadline'
        fi
    fi

    # Exercise a native open dialog and cancellation without changing the
    # validated report or the visible workload results.
    xdotool windowactivate --sync "$window_id" >> "$run_dir/logs/interaction.log" 2>&1 || true
    xdotool mousemove --window "$window_id" 95 190 click 1 >> "$run_dir/logs/interaction.log" 2>&1 || true
    deadline=$((SECONDS + 15))
    open_dialog=''
    while (( SECONDS < deadline )); do
        open_dialog=$(xdotool search --onlyvisible --name 'Choose files to analyze' 2>/dev/null | tail -n 1 || true)
        [[ -n "$open_dialog" ]] && break
        sleep 0.25
    done
    if [[ -n "$open_dialog" ]]; then
        log_step "native open dialog id=$open_dialog"
        import -window root "$run_dir/screenshots/native-open-dialog.png" 2> "$run_dir/logs/import-open-dialog.log" || true
        xdotool key --window "$open_dialog" Escape >> "$run_dir/logs/interaction.log" 2>&1 || true
        native_dialogs=PASS
        sleep 1
    else
        log_step 'native open dialog did not appear before the deadline'
    fi

    xdotool windowsize --sync "$window_id" 900 650 >> "$run_dir/logs/interaction.log" 2>&1 || true
    sleep 1
    xdotool windowminimize "$window_id" >> "$run_dir/logs/interaction.log" 2>&1 || true
    sleep 1
    xdotool windowmap "$window_id" >> "$run_dir/logs/interaction.log" 2>&1 || true
    xdotool windowactivate --sync "$window_id" >> "$run_dir/logs/interaction.log" 2>&1 || true
    xdotool mousemove --window "$window_id" 500 500 click --repeat 6 5 >> "$run_dir/logs/interaction.log" 2>&1 || true
    sleep 2
    import -window "$window_id" "$run_dir/screenshots/octane-restored-scrolled.png" 2> "$run_dir/logs/import-restored.log" || true
fi

ps -ww -eo pid,ppid,etimes,args > "$run_dir/logs/processes.txt"
grep -i 'msedgewebview2.exe' "$run_dir/logs/processes.txt" > "$run_dir/logs/webview2-process-command-lines.txt" || true

completed_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
jq -n \
    --arg runId "$run_id" \
    --arg startedAtUtc "$started_at" \
    --arg completedAtUtc "$completed_at" \
    --arg appSha256 "$app_sha" \
    --arg nativeWindow "$native_window" \
    --arg screenChanged "$screen_changed" \
    --arg workload "$workload" \
    --arg nativeDialogs "$native_dialogs" \
    --arg exportStatus "$export_status" \
    --arg overwriteDecline "$overwrite_decline" \
    --arg reportSha256 "$report_sha_before" \
    --arg pixelDifference "$pixel_difference" \
    --arg repaintNudge "$repaint_nudge" \
    --argjson repaintNudgeDurationMs "$repaint_nudge_ms" \
    --argjson repaintNudgeAttempts "$repaint_nudge_attempts" \
    --argjson clientColorCount "$client_color_count" \
    '{
      schemaVersion: 1,
      runId: $runId,
      startedAtUtc: $startedAtUtc,
      completedAtUtc: $completedAtUtc,
      installedExecutableSha256: $appSha256,
      observations: {
        nativeWindow: $nativeWindow,
        focusRepaintPixelChange: $screenChanged,
        pixelDifference: (if ($pixelDifference | test("^[0-9]+$")) then ($pixelDifference | tonumber) else null end),
        repaintNudge: $repaintNudge,
        repaintNudgeDurationMs: $repaintNudgeDurationMs,
        repaintNudgeAttempts: $repaintNudgeAttempts,
        clientColorCount: $clientColorCount,
        workload: $workload,
        nativeDialogs: $nativeDialogs,
        export: $exportStatus,
        overwriteDecline: $overwriteDecline,
        visualReview: "NOT_RUN"
      },
      reportSha256: (if $reportSha256 == "" then null else $reportSha256 end),
      securityExceptions: [],
      qualification: "Pixel change and report validation do not replace final native-window screenshot review."
    }' > "$run_dir/scenario.json"

(cd "$run_dir" && find . -type f ! -name checksums.sha256 -print0 | sort -z | xargs -0 sha256sum > checksums.sha256)
cat "$run_dir/scenario.json"

if [[ "$native_window" != PASS || "$screen_changed" != PASS || "$workload" != PASS || "$native_dialogs" != PASS || "$export_status" != PASS || "$overwrite_decline" != PASS ]]; then
    exit 1
fi

