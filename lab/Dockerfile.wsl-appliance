# syntax=docker/dockerfile:1.7
ARG UBUNTU_BASE=ubuntu@sha256:2198e4c65076e9cb0b3d695219df667c0e3b0072da64ca3c2648aca17dcecaf5
FROM ${UBUNTU_BASE}

ARG OCTANE_APPLIANCE_VERSION=1.0.0-candidate
ARG OCTANE_SOURCE_COMMIT=unknown
ARG DOCKER_CE_VERSION=5:29.6.2-1~ubuntu.24.04~noble
ARG CONTAINERD_VERSION=2.2.6-1~ubuntu.24.04~noble
ARG BUILDX_VERSION=0.36.0-1~ubuntu.24.04~noble
ARG COMPOSE_VERSION=5.3.1-1~ubuntu.24.04~noble

LABEL org.opencontainers.image.title="Octane WSL appliance root filesystem" \
      org.opencontainers.image.version="${OCTANE_APPLIANCE_VERSION}" \
      com.octanelab.source-commit="${OCTANE_SOURCE_COMMIT}" \
      com.octanelab.appliance="true"

ENV DEBIAN_FRONTEND=noninteractive

RUN set -eux; \
    printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d; \
    chmod 0755 /usr/sbin/policy-rc.d; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      ca-certificates curl dbus-user-session gnupg iproute2 iptables jq locales \
      procps sudo systemd systemd-sysv tar tzdata uidmap xz-utils zstd; \
    install -m 0755 -d /etc/apt/keyrings; \
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc; \
    chmod 0644 /etc/apt/keyrings/docker.asc; \
    printf 'deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu noble stable\n' \
      > /etc/apt/sources.list.d/docker.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      "docker-ce=${DOCKER_CE_VERSION}" \
      "docker-ce-cli=${DOCKER_CE_VERSION}" \
      "containerd.io=${CONTAINERD_VERSION}" \
      "docker-buildx-plugin=${BUILDX_VERSION}" \
      "docker-compose-plugin=${COMPOSE_VERSION}"; \
    rm -f /usr/sbin/policy-rc.d; \
    apt-mark hold docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin; \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    useradd --create-home --uid 10001 --shell /bin/bash octane; \
    usermod -aG docker octane; \
    install -d -m 0755 /etc/docker /opt/octane-appliance; \
    printf '%s\n' \
      '{' \
      '  "log-driver": "json-file",' \
      '  "log-opts": {"max-size": "10m", "max-file": "3"}' \
      '}' > /etc/docker/daemon.json; \
    printf '%s\n' \
      '[boot]' \
      'systemd=true' \
      '' \
      '[automount]' \
      'enabled=true' \
      'root=/mnt/' \
      'options="metadata,umask=22,fmask=11"' \
      '' \
      '[interop]' \
      'enabled=false' \
      'appendWindowsPath=false' \
      '' \
      '[user]' \
      'default=octane' > /etc/wsl.conf; \
    printf '{"schemaVersion":1,"kind":"octane-wsl-appliance","version":"%s","sourceCommit":"%s","dockerVersion":"29.6.2","managementPlane":"Windows PowerShell launcher"}\n' \
      "${OCTANE_APPLIANCE_VERSION}" "${OCTANE_SOURCE_COMMIT}" > /etc/octane-appliance.json; \
    ln -sf /init /usr/bin/wslpath; \
    systemctl enable docker.service containerd.service; \
    printf 'en_US.UTF-8 UTF-8\n' > /etc/locale.gen; \
    locale-gen; \
    rm -f /etc/machine-id; \
    touch /etc/machine-id; \
    rm -rf /tmp/* /var/tmp/* /var/log/*

COPY packaging/appliance/octane-appliance /usr/local/bin/octane-appliance
RUN chmod 0755 /usr/local/bin/octane-appliance

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
