#!/usr/bin/env bash
set -euo pipefail

state_dir="${OCTANE_STATE_DIR:-/home/wineuser/.octane}"
evidence_dir="${OCTANE_EVIDENCE_DIR:-$state_dir/evidence}"
password_file="${OCTANE_VIEWER_PASSWORD_FILE:-/run/octane/viewer-password}"
viewer_port="${OCTANE_BROWSER_CONTAINER_PORT:-3000}"
upload_port="${OCTANE_UPLOAD_CONTAINER_PORT:-3002}"
upload_url="${OCTANE_UPLOAD_PUBLIC_URL:-}"
origins="${OCTANE_VIEWER_ORIGINS:-http://127.0.0.1:3000 http://localhost:3000}"
mkdir -p "$state_dir" "$evidence_dir/browser" "$HOME/.config/xfce4"

if [[ ! -f "$password_file" || ! -s "$password_file" ]]; then
    echo "The per-run viewer password file is missing or empty: $password_file" >&2
    exit 64
fi

cleanup() {
    local status=$?
    trap - EXIT INT TERM
    for pid in "${websockify_pid:-}" "${upload_pid:-}" "${x11vnc_pid:-}" "${desktop_pid:-}"; do
        [[ -z "$pid" ]] || kill "$pid" 2>/dev/null || true
    done
    wait 2>/dev/null || true
    exit "$status"
}
trap cleanup EXIT INT TERM

deadline=$((SECONDS + 30))
until xdpyinfo -display "$DISPLAY" >/dev/null 2>&1; do
    if (( SECONDS >= deadline )); then
        echo "X11 display $DISPLAY did not become ready." >&2
        exit 70
    fi
    sleep 0.2
done

dbus-run-session -- startxfce4 >"$evidence_dir/browser/xfce.log" 2>&1 &
desktop_pid=$!

x11vnc \
    -display "$DISPLAY" -forever -shared -rfbport 5901 -rfbportv6 0 -listen 127.0.0.1 -listen6 ::1 \
    -passwdfile "$password_file" -xkb -noshm -noxrecord -noxfixes \
    -o "$evidence_dir/browser/x11vnc.log" &
x11vnc_pid=$!

deadline=$((SECONDS + 30))
until ss -ltnH '( sport = :5901 )' | grep -q '127.0.0.1:5901'; do
    if ! kill -0 "$x11vnc_pid" 2>/dev/null; then
        echo 'x11vnc exited before its loopback listener became ready.' >&2
        exit 71
    fi
    if (( SECONDS >= deadline )); then
        echo 'x11vnc loopback listener did not become ready.' >&2
        exit 72
    fi
    sleep 0.2
done

/usr/local/bin/octane-upload-server >"$evidence_dir/browser/upload-server.log" 2>&1 &
upload_pid=$!

deadline=$((SECONDS + 30))
until ss -ltnH "( sport = :${upload_port} )" | grep -q ":${upload_port}"; do
    if ! kill -0 "$upload_pid" 2>/dev/null; then
        echo 'Upload service exited before its browser listener became ready.' >&2
        exit 75
    fi
    if (( SECONDS >= deadline )); then
        echo 'Upload service listener did not become ready.' >&2
        exit 76
    fi
    sleep 0.2
done

PYTHONPATH=/opt/websockify /opt/websockify/run \
    --web /opt/novnc --file-only --heartbeat 30 \
    --auth-plugin ExpectOrigin --auth-source "$origins" \
    "0.0.0.0:${viewer_port}" 127.0.0.1:5901 \
    >"$evidence_dir/browser/websockify.log" 2>&1 &
websockify_pid=$!

deadline=$((SECONDS + 30))
until ss -ltnH "( sport = :${viewer_port} )" | grep -q ":${viewer_port}"; do
    if ! kill -0 "$websockify_pid" 2>/dev/null; then
        echo 'Websockify exited before its browser listener became ready.' >&2
        exit 73
    fi
    if (( SECONDS >= deadline )); then
        echo 'Browser listener did not become ready.' >&2
        exit 74
    fi
    sleep 0.2
done

jq -n \
    --arg runId "${OCTANE_RUN_ID:-unassigned}" \
    --arg display "$DISPLAY" \
    --arg resolution "$(xdpyinfo | awk '/dimensions:/{print $2; exit}')" \
    --arg transport 'noVNC 1.7.0 / Websockify 0.13.0 / x11vnc' \
    --arg uploadUrl "$upload_url" \
    '{schemaVersion:1,runId:$runId,display:$display,resolution:$resolution,transport:$transport,uploadUrl:($uploadUrl|if length>0 then . else null end),applicationReadiness:"unverified"}' \
    > "$state_dir/browser-session.json"

{
    echo "started_at_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "display=$DISPLAY"
    echo "resolution=$(xdpyinfo | awk '/dimensions:/{print $2; exit}')"
    echo "viewer_port=$viewer_port"
    echo "upload_port=$upload_port"
    echo "upload_url=$upload_url"
    echo "allowed_origins=$origins"
    echo 'authentication=rfb-password-file'
    echo 'clipboard=false'
    echo 'remote_resize=false'
    echo 'rdp_required=false'
    echo 'listeners:'
    ss -lntp
    echo 'processes:'
    ps -eo pid,ppid,user,comm,args
} >"$evidence_dir/browser/session-start.txt"

wait "$websockify_pid"
